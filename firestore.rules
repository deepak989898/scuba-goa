rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /packages/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    /** Promo codes for online checkout; public read, admin write. */
    match /offers/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /services/{slug} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /heroSlides/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    /** Admin-managed SEO landing pages at `/guides/{slug}`. Drafts readable only by admins. */
    match /seoPages/{slug} {
      allow read: if resource.data.published == true
        || (request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    /** Auto + manual SEO blogs at `/blog/{slug}`. Cron uses Admin SDK. */
    match /blogPosts/{slug} {
      allow read: if resource.data.published == true
        || (request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /blogTopicQueue/{id} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /blogAutomation/{docId} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    /** Cron slot completion tracking (server writes only). */
    match /blogDailyRuns/{date} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /homeGallery/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /bookings/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** Written by server (Admin SDK) via /api/marketing/lead; admin UI reads & updates follow-up flags. */
    match /marketingLeads/{id} {
      allow read, update: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create, delete: if false;
    }
    match /pageViews/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /analyticsSessions/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** Aggregated guide traffic counters (server writes only). */
    match /analyticsGuideTraffic/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** Per guide+session dedupe records for unique visitor counting (server writes only). */
    match /analyticsGuideTrafficVisitors/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** Aggregated blog post traffic (server writes only). */
    match /analyticsBlogTraffic/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /analyticsBlogTrafficVisitors/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** Daily AI analytics snapshots + reports (cron / admin APIs only). */
    match /aiAnalyticsDaily/{date} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /aiAnalyticsReports/{date} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** Daily conversion funnel + OpenAI optimization reports. */
    match /conversionOptDaily/{date} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /conversionOptReports/{date} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** Weekly SEO snapshots + AI reports (cron / admin APIs only). */
    match /seoWeekly/{weekId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /seoWeeklyReports/{weekId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** AI autonomous business ops agent (read-only for admins). */
    match /businessAgentRuns/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /businessAgentActions/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /businessAgentReports/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /businessAgentRollbackHistory/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** WhatsApp + booking recovery AI agent (server / cron only). */
    match /recoveryLeads/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /recoveryAbandonedBookings/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /recoveryConversations/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /recoveryCampaigns/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /recoveryWhatsappEvents/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /recoveryAiResponses/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /recoveryAgent/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    /** Checkout funnel events (server + client track). */
    match /paymentEvents/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
    match /ratings/{id} {
      allow read: if resource.data.approved == true
        || (request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if false;
      allow update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
