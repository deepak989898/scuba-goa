h != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n    match /blogTopicQueue/{id} {\n      allow read, write: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n    match /blogAutomation/{docId} {\n      allow read, write: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n    /** Cron slot completion tracking (server writes only). */\n    match /blogDailyRuns/{date} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    match /homeGallery/{id} {\n      allow read: if true;\n      allow create, update, delete: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n    match /bookings/{id} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    /** Written by server (Admin SDK) via /api/marketing/lead; admin UI reads & updates follow-up flags. */\n    match /marketingLeads/{id} {\n      allow read, update: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow create, delete: if false;\n    }\n    match /pageViews/{id} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    match /analyticsSessions/{id} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    /** Aggregated guide traffic counters (server writes only). */\n    match /analyticsGuideTraffic/{id} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    /** Per guide+session dedupe records for unique visitor counting (server writes only). */\n    match /analyticsGuideTrafficVisitors/{id} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    /** Aggregated blog post traffic (server writes only). */\n    match /analyticsBlogTraffic/{id} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    match /analyticsBlogTrafficVisitors/{id} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    match /analyticsEventIds/{id} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    match /analyticsRateLimits/{id} {\n      allow read, write: if false;\n    }\n    /** Daily AI analytics snapshots + reports (cron / admin APIs only). */\n    match /aiAnalyticsDaily/{date} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    match /aiAnalyticsReports/{date} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    /** Daily conversion funnel + OpenAI optimization reports. */\n    match /conversionOptDaily/{date} {\n      allow read: if request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n      allow write: if false;\n    }\n    match /conversionOptReports/{date} {\n      allow read: if request.auth != null\n        && exists(/databases/$