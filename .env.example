# =============================================================================
# Book Scuba Goa — environment variables checklist
# =============================================================================
# Copy to `.env.local` for local dev. On Vercel: Project → Settings → Environment
# Variables → add each name + value for Production (and Preview if needed).
#
# After ANY change: redeploy (`npx vercel --prod` or push to GitHub).
# NEXT_PUBLIC_* vars are baked into the browser bundle at BUILD time — redeploy
# required after changing them.
#
# Never commit real secrets to Git. Use placeholders below.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — site + contact (public)
# -----------------------------------------------------------------------------
# Live URL — must match your domain exactly (no trailing slash is OK).
# Where: your domain, or Vercel project domain before custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://bookscubagoa.com

NEXT_PUBLIC_CONTACT_PHONE_PRIMARY=918354075026
NEXT_PUBLIC_WHATSAPP_NUMBER=918354075026
NEXT_PUBLIC_CONTACT_PHONE_SECOND=919217290871
NEXT_PUBLIC_CONTACT_EMAIL=support@bookscubagoa.com
# Optional: different number for missed-call tracking
NEXT_PUBLIC_MISSED_CALL_NUMBER=

# -----------------------------------------------------------------------------
# REQUIRED — Firebase client (public — browser + admin login)
# Where: Firebase Console → Project settings → General → Your apps → Web app
#        → SDK setup and configuration (copy each field).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# REQUIRED — Firebase Admin (server only — bookings, chat, AI, admin APIs)
# Where: Firebase Console → Project settings → Service accounts →
#        Generate new private key → download JSON → paste ENTIRE JSON on ONE line.
#        Escape newlines in private_key as \n (or use Vercel multiline paste).
# Also add service account email as Viewer in GA4 + User in Search Console.
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional server-only bucket override (usually same as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
FIREBASE_STORAGE_BUCKET=

# -----------------------------------------------------------------------------
# REQUIRED — Razorpay payments (checkout + verify)
# Where: Razorpay Dashboard → Settings → API Keys → Generate Key
#        Key ID starts with rzp_test_ (test) or rzp_live_ (production).
#        Key Secret is shown ONCE when generated — copy immediately.
#
# CRITICAL: All three must be from the SAME mode (all test OR all live):
#   NEXT_PUBLIC_RAZORPAY_KEY_ID  = Key ID (public — checkout popup)
#   RAZORPAY_KEY_ID              = same Key ID again
#   RAZORPAY_KEY_SECRET          = Key Secret only (never the Key ID)
#
# If checkout shows "Authentication failed": Key ID in browser ≠ Key used to create order.
# Fix: set all three correctly → redeploy (NEXT_PUBLIC needs rebuild).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=

# Optional: HMAC secret for signed booking bill share links (else uses RAZORPAY_KEY_SECRET)
BOOKING_BILL_SHARE_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED — Vercel Cron (all /api/cron/* routes)
# Where: invent a long random string (32+ chars). Same value in Vercel env only.
#        Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED for admin + AI chat + blog (server only)
# Where: https://platform.openai.com/api-keys → Create secret key
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — marketing & analytics (public — browser)
# -----------------------------------------------------------------------------
# GA4 Measurement ID — Firebase Console → Analytics OR GA4 → Admin → Data streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity — clarity.microsoft.com → Project → Settings → Tracking code
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Meta Pixel — Meta Events Manager → Data sources → Your pixel → Pixel ID (digits)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console HTML tag verification (content value only, not full tag)
# Search Console → Add property → Verify → HTML tag → copy content="..." value
GOOGLE_SITE_VERIFICATION=

# Optional hero background music URL
NEXT_PUBLIC_HERO_FALLBACK_MUSIC_URL=

# -----------------------------------------------------------------------------
# OPTIONAL — booking emails (Resend)
# Where: https://resend.com/api-keys → Create API Key
#        Verify your domain in Resend → use verified address as RESEND_FROM_EMAIL
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@bookscubagoa.com
BOOKING_ADMIN_NOTIFY_EMAIL=support@bookscubagoa.com
ADMIN_NOTIFY_EMAIL=

# -----------------------------------------------------------------------------
# OPTIONAL — blog automation images
# Where: https://www.pexels.com/api/ → Get API key
# -----------------------------------------------------------------------------
PEXELS_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — AI Analytics Agent (/admin/ai-analytics, daily cron)
# -----------------------------------------------------------------------------
# GA4 numeric Property ID (NOT G- measurement ID)
# GA4 → Admin → Property settings → Property ID (e.g. 529273353)
GOOGLE_ANALYTICS_PROPERTY_ID=

# Search Console property URL — must match GSC exactly (usually trailing slash)
# Search Console → property dropdown → copy URL e.g. https://bookscubagoa.com/
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://bookscubagoa.com/

# Optional separate service account JSON for Google APIs (defaults to FIREBASE_SERVICE_ACCOUNT_KEY)
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON=

# Telegram daily digest
# Bot token: message @BotFather on Telegram → /newbot → copy token
# Chat ID: message your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email for AI analytics report (uses Resend)
AI_ANALYTICS_REPORT_EMAIL=

# OpenAI model override (default gpt-4o-mini)
AI_ANALYTICS_OPENAI_MODEL=

# Meta WhatsApp Cloud API — automated reports / Recovery AI WhatsApp send
# Meta Business Suite → WhatsApp → API setup → temporary or permanent token + Phone number ID
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REPORT_RECIPIENT=918354075026

# -----------------------------------------------------------------------------
# OPTIONAL — competitor / trending scan (SEO AI, Marketing AI, Command Center)
# Where: https://serper.dev → API key
# -----------------------------------------------------------------------------
SERPER_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — Google Business Profile auto-post (blog → GBP)
# Setup guide: docs/GOOGLE-BUSINESS-PROFILE-SETUP.md
# Google Cloud Console → APIs → OAuth 2.0 Client ID (Web application)
# Redirect URI: https://bookscubagoa.com/api/admin/google-business/oauth-callback
# Or connect via /admin/blog-automation (stores tokens in Firestore)
# -----------------------------------------------------------------------------
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# =============================================================================
# AFTER MOVING TO A NEW VERCEL ACCOUNT — manual checklist
# =============================================================================
# 1. Re-add ALL env vars above in new Vercel project (they do NOT copy automatically).
# 2. Redeploy Production after env changes (especially NEXT_PUBLIC_*).
# 3. Vercel → Project → Settings → Domains → confirm bookscubagoa.com attached.
# 4. Firebase Console → Authentication → Settings → Authorized domains →
#    add: bookscubagoa.com AND your-project.vercel.app
# 5. Razorpay Dashboard → ensure live keys if taking real payments (not test keys).
# 6. GitHub → Settings → confirm new Vercel project still connected to same repo.
# 7. Vercel → Settings → Cron Jobs → confirm crons listed (needs CRON_SECRET).
# 8. Test: admin login, AI Help chat, cart Pay ₹199, booking email.
# =============================================================================
