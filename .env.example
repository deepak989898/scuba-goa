# =============================================================================
# Book Scuba Goa — environment variables checklist
# =============================================================================
# Copy to `.env.local` for local dev. On Vercel: Project → Settings → Environment
# Variables → add each name + value for Production (and Preview if needed).
#
# After ANY change: redeploy (`npx vercel --prod` or push to GitHub).
# NEXT_PUBLIC_* vars are baked into the browser bundle at BUILD time — redeploy
# required after changing them.
#
# Never commit real secrets to Git. Use placeholders below.
# =============================================================================

WHATSAPP_MOBILE_APP_SECRET=24x45f4d4b5c1x154b4fg5d4fbg5g4n5g4s54dsvs54s44s4f5a4aa45w4A81CV4GVSV16S4V646V41B654R5D41V5FS54S5FV546V51V4R5S54E541E15E41V151V1151V54R1V515V5VR11

# -----------------------------------------------------------------------------
# EMERGENCY — Firestore read pause (quota burn) — OFF by default
# Only pauses when UNTIL is set to a future ISO time (both server + NEXT_PUBLIC).
# To force resume while UNTIL is still set: DISABLED=1 on both, then redeploy.
# Wrong names like "firebase disabled" do nothing — use exact names below.
# -----------------------------------------------------------------------------
# FIRESTORE_READ_PAUSE_UNTIL=2026-08-04T00:00:00+05:30
# NEXT_PUBLIC_FIRESTORE_READ_PAUSE_UNTIL=2026-08-04T00:00:00+05:30
# FIRESTORE_READ_PAUSE_DISABLED=1
# NEXT_PUBLIC_FIRESTORE_READ_PAUSE_DISABLED=1

# -----------------------------------------------------------------------------
# REQUIRED — site + contact (public)
# -----------------------------------------------------------------------------
# Live URL — must match your domain exactly (no trailing slash is OK).
# Where: your domain, or Vercel project domain before custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://www.bookscubagoa.com

NEXT_PUBLIC_CONTACT_PHONE_PRIMARY=918354075026
NEXT_PUBLIC_WHATSAPP_NUMBER=918354075026
NEXT_PUBLIC_CONTACT_PHONE_SECOND=919217290871
NEXT_PUBLIC_CONTACT_EMAIL=support@bookscubagoa.com
# Optional: different number for missed-call tracking
NEXT_PUBLIC_MISSED_CALL_NUMBER=

# -----------------------------------------------------------------------------
# REQUIRED — Firebase client (public — browser + admin login)
# Where: Firebase Console → Project settings → General → Your apps → Web app
#        → SDK setup and configuration (copy each field).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# REQUIRED — Firebase Admin (server only — bookings, chat, AI, admin APIs)
# Where: Firebase Console → Project settings → Service accounts →
#        Generate new private key → download JSON → paste ENTIRE JSON on ONE line.
#        Escape newlines in private_key as \n (or use Vercel multiline paste).
# Also add service account email as Viewer in GA4 + User in Search Console.
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional server-only bucket override (usually same as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
FIREBASE_STORAGE_BUCKET=

# -----------------------------------------------------------------------------
# REQUIRED — Razorpay payments (checkout + verify)
# Where: Razorpay Dashboard → Settings → API Keys → Generate Key
#        Key ID starts with rzp_test_ (test) or rzp_live_ (production).
#        Key Secret is shown ONCE when generated — copy immediately.
#
# CRITICAL: All three must be from the SAME mode (all test OR all live):
#   NEXT_PUBLIC_RAZORPAY_KEY_ID  = Key ID (public — checkout popup)
#   RAZORPAY_KEY_ID              = same Key ID again
#   RAZORPAY_KEY_SECRET          = Key Secret only (never the Key ID)
#
# If checkout shows "Authentication failed": Key ID in browser ≠ Key used to create order.
# Fix: set all three correctly → redeploy (NEXT_PUBLIC needs rebuild).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=

# -----------------------------------------------------------------------------
# TripJack Hotels (Goa only) — server calls DigitalOcean proxy, NOT TripJack direct
# TRIPJACK_API_KEY must live ONLY on the VPS (tripjack-proxy/). Never add it here.
# -----------------------------------------------------------------------------
# http://YOUR_DIGITALOCEAN_STATIC_IP:4000
TRIPJACK_PROXY_BASE_URL=
NEXT_PUBLIC_TRIPJACK_HOTELS_ENABLED=true
TRIPJACK_HOTEL_ENV=staging

# Optional: HMAC secret for signed booking bill share links (else uses RAZORPAY_KEY_SECRET)
BOOKING_BILL_SHARE_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED — Vercel Cron (all /api/cron/* routes)
# Where: invent a long random string (32+ chars). Same value in Vercel env only.
#        Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# -----------------------------------------------------------------------------
CRON_SECRET=568942359412381423262165410
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=BM3ev9NqUo1oHSh2iY7ffrEAcOOVnQdMMFlNRsU1ier5RdH_15x6bL_C84qAFzhWrvB6NlnU1LV7a-8uUU2bu0Y
WEB_PUSH_VAPID_PRIVATE_KEY=775SX_rI-Stb7W4ubqepgSCdzs65lDPUYSnLtylsWC4
WEB_PUSH_VAPID_SUBJECT=mailto:support@bookscubagoa.com

# -----------------------------------------------------------------------------
# REQUIRED for admin + AI chat + blog (server only)
# Where: https://platform.openai.com/api-keys → Create secret key
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional — Web Push notifications (offers / marketing)
# Generate keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:support@bookscubagoa.com

# -----------------------------------------------------------------------------
# OPTIONAL — marketing & analytics (public — browser)
# -----------------------------------------------------------------------------
# GA4 Measurement ID — Firebase Console → Analytics OR GA4 → Admin → Data streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity — clarity.microsoft.com → Project → Settings → Tracking code
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Meta Pixel — Meta Events Manager → Data sources → Your pixel → Pixel ID (digits)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console HTML tag verification (content value only, not full tag)
# Search Console → Add property → Verify → HTML tag → copy content="..." value
GOOGLE_SITE_VERIFICATION=

# Optional hero background music URL
NEXT_PUBLIC_HERO_FALLBACK_MUSIC_URL=

# -----------------------------------------------------------------------------
# REQUIRED — booking & report emails (GoDaddy Titan SMTP — recommended)
# Where: Vercel → Project → Settings → Environment Variables (Production).
#        Firebase does NOT send booking emails — no SMTP settings in Firebase Console.
#
# Titan password = the same password you use to log in at secureserver.titan.email
# (NOT a Google app password, NOT Firebase, NOT Resend). No 2FA on this mailbox is OK.
#
# GoDaddy confirmed SMTP:
#   Host: smtp.secureserver.net
#   Port: 465 (SSL)
#
# Also fix DNS in GoDaddy (fixes yellow “set SPF records” banner in Titan inbox):
#   GoDaddy → Email & Office → Manage → Set Mail Destination
#   TXT @  v=spf1 include:secureserver.net -all
#   MX @ priority 0 → smtp.secureserver.net
#   MX @ priority 10 → mailstore1.secureserver.net
#   Then click “Check again” in Titan webmail.
#
# Outbound booking email: Resend is preferred on Vercel.
# With RESEND_API_KEY set, Titan SMTP is NOT used unless MAIL_SMTP_FALLBACK=1
# (avoids long SMTP hangs after a Resend failure).
# -----------------------------------------------------------------------------
MAIL_SMTP_HOST=smtp.secureserver.net
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=support@bookscubagoa.com
MAIL_SMTP_PASS=
MAIL_FROM=support@bookscubagoa.com
MAIL_PREFER_SMTP=
MAIL_SMTP_FALLBACK=
BOOKING_ADMIN_NOTIFY_EMAIL=support@bookscubagoa.com
ADMIN_NOTIFY_EMAIL=vedrajsingh94@gmail.com

# -----------------------------------------------------------------------------
# Resend API (required for reliable booking emails on Vercel)
# 1) https://resend.com/api-keys → Create API Key
# 2) Domains → Add bookscubagoa.com → verify DNS (must show Verified)
# 3) RESEND_FROM_EMAIL must be an address on that verified domain
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@bookscubagoa.com

# -----------------------------------------------------------------------------
# OPTIONAL — Booking SMS after successful payment (one message: details + invoice link)
# Firebase Auth SMS is OTP-only — use MSG91 (easiest for India) or Twilio.
#
# MSG91 (recommended for India):
#   https://msg91.com → Authkey → Sender ID (DLT-approved, max 6 chars)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=BSGOA
# MSG91_ROUTE=4
#
# Twilio (international alternative):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
#
# Invoice PDF links also need BOOKING_BILL_SHARE_SECRET (or RAZORPAY_KEY_SECRET fallback)
# and NEXT_PUBLIC_SITE_URL=https://www.bookscubagoa.com
# -----------------------------------------------------------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BSGOA
MSG91_ROUTE=4
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BOOKING_BILL_SHARE_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — blog automation images
# Where: https://www.pexels.com/api/ → Get API key
# -----------------------------------------------------------------------------
PEXELS_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — AI Analytics Agent (/admin/ai-analytics, daily cron)
# -----------------------------------------------------------------------------
# GA4 numeric Property ID (NOT G- measurement ID)
# GA4 → Admin → Property settings → Property ID (e.g. 529273353)
GOOGLE_ANALYTICS_PROPERTY_ID=

# Search Console property URL — must match GSC exactly (usually trailing slash)
# Search Console → property dropdown → copy URL e.g. https://bookscubagoa.com/
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://www.bookscubagoa.com/

# Optional separate service account JSON for GA4 (defaults to FIREBASE_SERVICE_ACCOUNT_KEY)
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON=
# Optional GSC-only account (defaults to FIREBASE first, then Analytics account)
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=

# Optional — Google Ads Keyword Planner (AI Blog Automation research)
# Without these, research still works via GSC + Suggest + service seeds.
# Metrics from Ads show as unavailable — volumes are never fabricated.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Telegram daily digest
# Bot token: message @BotFather on Telegram → /newbot → copy token
# Chat ID: message your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily AI analytics report also emails this inbox (defaults include support@bookscubagoa.com)
# AI_ANALYTICS_REPORT_EMAIL=support@bookscubagoa.com

# Email for AI analytics + business-agent daily reports (uses Titan SMTP or Resend)
AI_ANALYTICS_REPORT_EMAIL=support@bookscubagoa.com

# OpenAI model override (default gpt-4o-mini)
AI_ANALYTICS_OPENAI_MODEL=

# Custom Site Analytics v2 — IP hash for rate limits (server only; never NEXT_PUBLIC)
# ANALYTICS_IP_HASH_SECRET=long-random-string

# Optional — AI Pricing Agent (/admin/pricing-agent, Tuesday 06:00 IST cron)
# Market research uses public Serper SERP snippets (not private page scraping).
# AI_PRICING_OPENAI_MODEL=gpt-4o-mini
# SERPER_API_KEY=022e20596247ecf281640a93fce172ecf942f671y

# Meta WhatsApp Cloud API — automated reports / Recovery AI WhatsApp send
# Meta Business Suite → WhatsApp → API setup → temporary or permanent token + Phone number ID
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Webhook verify token — YOU choose this string; same value goes in Meta → Configure Webhooks → Verify token
# Callback URL in Meta: https://bookscubagoa.com/api/webhooks/whatsapp
META_WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REPORT_RECIPIENT=918354075026

# Android WhatsApp assistant app (notification auto-reply) — separate from Meta Cloud API / social media
# Generate a long random string; enter the same value in the Android app settings
WHATSAPP_MOBILE_APP_SECRET=

# OPENAI_API_KEY=  (required for blog text + images)

# Optional — OpenAI blog featured images (default gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium

# Free stock featured images when “without AI image” / stock automation is selected
# Primary → Fallback → Third
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — SEO Blog Center (/admin/seo-blog-center)
# Uses GSC + Google Suggest + city research → auto blog publish with schema & ALT.
# Requires OPENAI_API_KEY. Optional SERPER_API_KEY for related searches.
# GSC: GOOGLE_SEARCH_CONSOLE_SITE_URL + Firebase service account in Search Console.
# -----------------------------------------------------------------------------
# SERPER_API_KEY=  # optional — same as competitor scan key above

# -----------------------------------------------------------------------------
# OPTIONAL — SEO Intelligence (/admin/seo-intelligence)
# Competitor discovery + keyword rankings via SERP provider abstraction.
# Reuses SERPER_API_KEY / SERP_API_KEY. Does not replace GSC Indexing Agent.
# Auto-approve defaults OFF in code regardless of SEO_AUTO_APPROVE_DEFAULT.
# -----------------------------------------------------------------------------
# SERP_PROVIDER=serper
# SERP_API_KEY=
# SERP_LOCATION=Goa,India
# SERP_COUNTRY=IN
# SERP_LANGUAGE=en
# SEO_COMPETITOR_AUTO_DISCOVERY=true
# SEO_AUTO_APPROVE_DEFAULT=false
# SEO_MAX_DAILY_CHANGES=10
# SEO_MAX_WEEKLY_NEW_PAGES=3
# SEO_MIN_AUTO_APPROVE_CONFIDENCE=85

# -----------------------------------------------------------------------------
# OPTIONAL — Google Business Profile auto-post (blog → GBP)
# Setup guide: docs/GOOGLE-BUSINESS-PROFILE-SETUP.md
# Google Cloud Console → APIs → OAuth 2.0 Client ID (Web application)
# Redirect URI: https://bookscubagoa.com/api/admin/google-business/oauth-callback
# Or connect via /admin/blog-automation (stores tokens in Firestore)
# -----------------------------------------------------------------------------
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# =============================================================================
# AFTER MOVING TO A NEW VERCEL ACCOUNT — manual checklist
# =============================================================================
# 1. Re-add ALL env vars above in new Vercel project (they do NOT copy automatically).
# 2. Redeploy Production after env changes (especially NEXT_PUBLIC_*).
# 3. Vercel → Project → Settings → Domains → confirm bookscubagoa.com attached.
# 4. Firebase Console → Authentication → Settings → Authorized domains →
#    add: bookscubagoa.com AND your-project.vercel.app
# 5. Razorpay Dashboard → ensure live keys if taking real payments (not test keys).
# 6. GitHub → Settings → confirm new Vercel project still connected to same repo.
# 7. Vercel → Settings → Cron Jobs → confirm crons listed (needs CRON_SECRET).
# 8. Test: admin login, AI Help chat, cart Pay ₹199, booking email.
# =============================================================================
